{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WordQuest9 Unit Vocabulary Schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "unit",
      "unit_title",
      "word",
      "pos",
      "ipa",
      "meaning_vi",
      "example_en",
      "example_vi",
      "word_forms"
    ],
    "properties": {
      "unit": { "type": "integer", "minimum": 1, "maximum": 12 },
      "unit_title": { "type": "string", "minLength": 1 },
      "word": { "type": "string", "minLength": 1 },
      "pos": {
        "type": "string",
        "enum": ["noun", "verb", "adj", "adv", "phrase", "prep", "conj", "pron"]
      },
      "ipa": { "type": "string", "minLength": 1 },
      "meaning_vi": { "type": "string", "minLength": 1 },
      "example_en": { "type": "string", "minLength": 1 },
      "example_vi": { "type": "string", "minLength": 1 },
      "word_forms": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["word", "pos", "meaning_vi"],
          "properties": {
            "word": { "type": "string", "minLength": 1 },
            "pos": {
              "type": "string",
              "enum": ["noun", "verb", "adj", "adv", "phrase", "prep"]
            },
            "meaning_vi": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
