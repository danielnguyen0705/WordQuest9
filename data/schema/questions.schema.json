{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WordQuest9 Unit Question Bank Schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "unit",
      "target_word",
      "question_type",
      "prompt_text",
      "correct_answer",
      "distractors",
      "explanation_vi"
    ],
    "properties": {
      "unit": { "type": "integer", "minimum": 1, "maximum": 12 },
      "target_word": { "type": "string", "minLength": 1 },
      "question_type": {
        "type": "string",
        "enum": [
          "translation_en_vi",
          "translation_vi_en",
          "contextual_mcq",
          "word_form",
          "listening"
        ]
      },
      "prompt_text": { "type": "string", "minLength": 1 },
      "correct_answer": { "type": "string", "minLength": 1 },
      "distractors": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": { "type": "string", "minLength": 1 }
      },
      "explanation_vi": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false
  }
}
