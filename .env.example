# ==============================================
# WordQuest 9 - Environment Configuration Example
# ==============================================

# --- Database (PostgreSQL - Local Docker or Neon / Supabase) ---
POSTGRES_USER=wordquest
POSTGRES_PASSWORD=wordquest_secret_change_me
POSTGRES_DB=wordquest9
DATABASE_URL=postgresql+psycopg://wordquest:wordquest_secret_change_me@postgres:5432/wordquest9
# Cloud Example (Neon / Supabase):
# DATABASE_URL=postgresql+psycopg://user:password@ep-example.us-east-2.aws.neon.tech/wordquest9?sslmode=require

# --- Security & JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-64-char-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Game Rules ---
SESSION_QUESTION_COUNT=20
WARMUP_CARD_COUNT=6
MISTAKE_MASTERY_THRESHOLD=2

# --- Microservice URLs (Internal Docker Network or Cloud Service URLs) ---
IDENTITY_SERVICE_URL=http://identity-service:8001
VOCABULARY_SERVICE_URL=http://vocabulary-service:8002
QUIZ_ENGINE_SERVICE_URL=http://quiz-engine-service:8003
PROGRESS_SERVICE_URL=http://progress-service:8004
MCP_SERVER_PORT=8005

# --- Data Directory ---
DATA_DIR=/app/data

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
